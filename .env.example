# Copy to .env and adjust for local demo. Never commit .env.

# Flask session signing key — use a long random string.
SECRET_KEY=change-me-to-a-random-string

# Optional: override demo admin password (default is "admin").
# ADMIN_PASSWORD=admin
# Or provide a werkzeug hash directly:
# ADMIN_PASSWORD_HASH=

# Optional SSH settings for metric collection (prefer key auth).
# SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# SSH_PASSWORD=
